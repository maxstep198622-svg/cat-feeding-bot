# systemd-сервис для Linux-сервера или Raspberry Pi.
#
# Установка (один раз):
#   sudo useradd --system --home /opt/cat_bot --shell /usr/sbin/nologin catbot
#   sudo git clone <адрес репозитория cat-feeding-bot> /opt/cat_bot
#   cd /opt/cat_bot && sudo python3 -m venv .venv && sudo .venv/bin/pip install -r requirements.txt
#   sudo cp config.example.toml config.toml && sudo nano config.toml      # вес, корма, join_code
#   echo "CATBOT_TOKEN=123456:ABC..." | sudo tee .env && sudo chmod 600 .env
#   sudo mkdir -p data && sudo chown -R catbot:catbot /opt/cat_bot/data /opt/cat_bot/.env
#   sudo .venv/bin/python -m catbot --check                               # проверка конфига
#   sudo cp deploy/catbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now catbot
# Логи: journalctl -u catbot -f
[Unit]
Description=Cat feeding reminder Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catbot
WorkingDirectory=/opt/cat_bot
EnvironmentFile=/opt/cat_bot/.env
ExecStart=/opt/cat_bot/.venv/bin/python -m catbot --config /opt/cat_bot/config.toml
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/cat_bot/data

[Install]
WantedBy=multi-user.target
